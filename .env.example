# Fixed assignment reference date (ISO YYYY-MM-DD). Must be an explicit,
# deliberately configured value — never derived from the runtime clock.
# Falls back to 2026-10-02 (the confirmed assignment default) if unset.
APP_REFERENCE_DATE=2026-10-02

# Optional override for the DuckDB snapshot file path.
# Defaults to <project_root>/output/customer_requests.duckdb if unset.
# APP_DB_PATH=/app/output/customer_requests.duckdb
